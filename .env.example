# --- Slack app credentials (Socket Mode) ---
# Bot token, starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token, starts with xapp-, needs the connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token
# Signing secret, from Basic Information -> App Credentials
SLACK_SIGNING_SECRET=your-signing-secret

# --- Where tickets live ---
# Channel ID where new tickets get posted (e.g. #support)
SUPPORT_CHANNEL_ID=C0000000000
# Channel ID for the daily summary post. Defaults to SUPPORT_CHANNEL_ID if unset.
SUMMARY_CHANNEL_ID=

# --- Who counts as a helper ---
# Slack user group (subteam) ID whose members can resolve tickets, e.g. S0000000000
# Find it via the Slack usergroups.list API or the "People" tab of a user group's page.
SUPPORT_USERGROUP_ID=S0000000000

# --- FAQ ---
# Link to your FAQ canvas (right click the canvas -> Copy link)
FAQ_CANVAS_URL=https://yourteam.slack.com/docs/T000/F000

# --- Daily summary schedule ---
# Cron expression, default is 9am every day
DAILY_SUMMARY_CRON=0 9 * * *
# IANA timezone for the cron schedule
TIMEZONE=UTC

# --- Storage ---
# Path to the sqlite file, created automatically
DB_PATH=./data/hestia.db
