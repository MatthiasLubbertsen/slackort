# --- Slack app credentials (Socket Mode) ---
# Bot token, starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token, starts with xapp-, needs the connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token
# Signing secret, from Basic Information -> App Credentials
SLACK_SIGNING_SECRET=your-signing-secret

# --- Super admin ---
# Comma-separated Slack user IDs. Only used to bootstrap trust: super admins
# can add/edit Programs from the Home tab's admin tab. Everything else
# (channels, usergroups, welcome messages, shortcuts, FAQ/admin links) is
# configured per-Program from Slack itself, not env vars.
SUPER_ADMIN_USER_ID=U0000000000

# --- Daily summary schedule ---
# Cron expression, default is 9am every day. Each Program gets its own post,
# to its own BTS channel.
DAILY_SUMMARY_CRON=0 9 * * *
# IANA timezone for the cron schedule
TIMEZONE=UTC

# --- Storage ---
# Path to the sqlite file, created automatically
DB_PATH=./data/hestia.db

# --- Placeholder web page (hestia.matthiaz.dev) ---
# No auth, just says "hi" for now. Set to 0 to disable.
WEB_PORT=7777

# --- Read-only stats API (api.hestia.matthiaz.dev) ---
# No auth on purpose, only ever reads. Set to 0 to disable.
API_PORT=7778

# --- Accidental double-post window ---
# Minutes after opening a ticket during which a second top-level message from
# the same person gets redirected to their existing thread instead of opening
# a new ticket. After this window, a new message opens a genuinely new ticket.
DUPLICATE_WINDOW_MINUTES=5

# --- Legacy single-program bootstrap (optional) ---
# Only read once, on first boot, if no Program exists yet in the database.
# Turns these into your first Program automatically so an existing
# single-channel deployment keeps working without re-entering everything by
# hand. Safe to delete once that Program exists and is managed from the Home
# tab's admin tab instead.
SUPPORT_CHANNEL_ID=
SUMMARY_CHANNEL_ID=
SUPPORT_USERGROUP_ID=
FAQ_CANVAS_URL=
STARDANCE_ADMIN_URL=
